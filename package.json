{
  "name": "cap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "compile": "tsc -b tsconfig.json",
    "compile-v": "tsc -b tsconfig.json --verbose --listFiles",
    "lint": "eslint -c configs/eslint.config.js --cache --cache-location cache/.eslintcache",
    "lint-v": "eslint -c configs/eslint.config.js --cache --cache-location cache/.eslintcache --debug",
    "_format": "prettier . --cache --cache-location cache/.prettier-cache",
    "format": "prettier . --cache --cache-location cache/.prettier-cache --list-different --write",
    "format-v": "prettier . --cache --cache-location cache/.prettier-cache --log-level debug --write",
    "all": "tsc -b tsconfig.json && eslint -c configs/eslint.config.js --cache --cache-location cache/.eslintcache && prettier . --cache --cache-location cache/.prettier-cache --list-different --write",
    "all-v": "tsc -b tsconfig.json --verbose --listFiles && eslint -c configs/eslint.config.js --cache --cache-location cache/.eslintcache --debug && prettier . --cache --cache-location cache/.prettier-cache --log-level debug --write",
    "build": "vite build -c configs/vite.config.ts",
    "dev": "vite -c configs/vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.17.0",
    "@emotion/react": "^11.14.0",
    "@xyflow/react": "^12.6.0",
    "konva": "^9.3.20",
    "next-themes": "^0.4.6",
    "peaks.js": "^3.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "waveform-data": "^4.5.1",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.17.0",
    "@eslint/js": "^9.26.0",
    "@redux-devtools/extension": "^3.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
